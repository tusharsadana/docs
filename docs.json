              "guides/discovering-results",
              "guides/exporting-results"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "guides/webhooks"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "guides/errors-and-rate-limits"
            ]
          }
